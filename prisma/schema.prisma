generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                      @id @default(cuid())
  email                   String                      @unique
  phone                   String?                     @unique
  name                    String
  roles                   Role[]                      @default([SEEKER])
  identityStatus          VerificationStatus          @default(PENDING)
  phoneVerifiedAt         DateTime?
  emailVerifiedAt         DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  passwordHash            String?
  accountStatus           String                      @default("ACTIVE")
  lastLoginAt             DateTime?
  agencyMemberships       AgencyAgent[]
  viewingAvailability     AgentViewingAvailability?
  sessions                AppSession[]
  auditEvents             AuditEvent[]
  conversations           ConversationParticipant[]
  emailVerificationTokens EmailVerificationToken?
  enquiries               Enquiry[]                   @relation("SeekerEnquiries")
  favourites              Favourite[]
  listings                Listing[]
  messagesSent            Message[]                   @relation("MessagesSent")
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  payments                Payment[]
  reports                 Report[]
  reviewsGiven            Review[]                    @relation("ReviewAuthor")
  roommateProfile         RoommateProfile?
  savedSearches           SavedSearch[]
  documents               UserDocument[]
  couponUsages            AcademyCouponUsage[]
  createdCoupons          AcademyCoupon[]
  academyApplications     AcademyLearnerApplication[]
  academyResourceAccess   AcademyResourceAccess[]
  agentBadge              AgentBadge[]
  courseReviews           CourseReview[]
  waitlistEntries         CourseWaitlist[]
  forumPosts              ForumPost[]
  forumReplies            ForumReply[]
  learnerAnalytics        LearnerAnalytics[]
  libraryDownloads        LibraryDownloadAccess[]
  libraryGuestClaims      LibraryGuestClaim[]
  libraryOrders           LibraryOrder[]
  libraryReviews          LibraryReview[]
  libraryWishlist         LibraryWishlistItem[]
  pushNotifications       PushNotification[]
  refundRequests          RefundRequest[]
}

model BlogAuthor {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  role      String?
  bio       String?
  avatarUrl String?
  email     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]

  @@map("blog_authors")
}

model BlogCategory {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  imageUrl        String?
  seoTitle        String?
  metaDescription String?
  sortOrder       Int        @default(0)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  posts           BlogPost[]

  @@index([active])
  @@index([sortOrder])
  @@map("blog_categories")
}

model BlogTag {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[] @relation("BlogPostToBlogTag")

  @@index([active])
  @@map("blog_tags")
}

model BlogPost {
  id                String                @id @default(cuid())
  title             String
  slug              String                @unique
  excerpt           String
  status            BlogPostStatus        @default(DRAFT)
  layout            BlogArticleLayout     @default(STANDARD_ARTICLE)
  categoryId        String?
  authorId          String?
  featuredImageUrl  String?
  featuredImageAlt  String?
  socialImageUrl    String?
  contentBlocks     Json
  contentText       String                @default("")
  seoTitle          String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String[]              @default([])
  canonicalUrl      String?
  noIndex           Boolean               @default(false)
  featured          Boolean               @default(false)
  popular           Boolean               @default(false)
  readTimeMinutes   Int                   @default(4)
  viewCount         Int                   @default(0)
  searchVector      String                @default("")
  scheduledAt       DateTime?
  publishedAt       DateTime?
  lastEditedById    String?
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  archivedAt        DateTime?
  feedback          BlogArticleFeedback[]
  comments          BlogComment[]
  downloads         BlogDownload[]
  author            BlogAuthor?           @relation(fields: [authorId], references: [id])
  category          BlogCategory?         @relation(fields: [categoryId], references: [id])
  questions         BlogReaderQuestion[]
  tags              BlogTag[]             @relation("BlogPostToBlogTag")

  @@index([status])
  @@index([publishedAt])
  @@index([featured])
  @@index([popular])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogComment {
  id          String        @id @default(cuid())
  postId      String
  parentId    String?
  authorName  String
  authorEmail String?
  body        String
  status      String        @default("PENDING")
  ipHash      String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parent      BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     BlogComment[] @relation("BlogCommentReplies")
  post        BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
  @@index([parentId])
  @@map("blog_comments")
}

model BlogArticleFeedback {
  id        String   @id @default(cuid())
  postId    String
  vote      String
  note      String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, vote])
  @@index([createdAt])
  @@map("blog_article_feedback")
}

model BlogReaderQuestion {
  id          String    @id @default(cuid())
  postId      String?
  name        String
  email       String?
  city        String?
  question    String
  status      String    @default("NEW")
  adminNote   String?
  articleSlug String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  post        BlogPost? @relation(fields: [postId], references: [id])

  @@index([status, createdAt])
  @@index([postId])
  @@map("blog_reader_questions")
}

model BlogDownload {
  id        String   @id @default(cuid())
  postId    String
  label     String
  url       String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, url])
  @@index([postId])
  @@map("blog_downloads")
}

model BlogSearchLog {
  id        String   @id @default(cuid())
  query     String
  category  String?
  tag       String?
  author    String?
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@map("blog_search_logs")
}

model BlogAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([actorId])
  @@map("blog_audit_logs")
}

model Agency {
  id                 String             @id @default(cuid())
  name               String
  phone              String
  email              String
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  city               String             @default("")
  accountStatus      String             @default("ACTIVE")
  subscriptionTier   String             @default("FREE")
  revenue            Decimal            @default(0) @db.Decimal(12, 2)
  leadConversion     Int                @default(0)
  agents             AgencyAgent[]
  listings           Listing[]
}

model AgencyAgent {
  agencyId  String
  userId    String
  title     String?
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([agencyId, userId])
}

model Listing {
  id                            String                    @id @default(cuid())
  ownerId                       String
  agencyId                      String?
  intent                        ListingIntent
  propertyType                  PropertyType
  status                        ListingStatus             @default(DRAFT)
  title                         String
  description                   String
  price                         Decimal                   @db.Decimal(12, 2)
  currency                      String                    @default("USD")
  city                          String
  suburb                        String
  addressLine                   String?
  latitude                      Decimal?                  @db.Decimal(10, 7)
  longitude                     Decimal?                  @db.Decimal(10, 7)
  bedrooms                      Int                       @default(0)
  bathrooms                     Int                       @default(0)
  furnished                     Boolean                   @default(false)
  parking                       Boolean                   @default(false)
  petFriendly                   Boolean                   @default(false)
  wifi                          Boolean                   @default(false)
  solarBackup                   Boolean                   @default(false)
  borehole                      Boolean                   @default(false)
  generator                     Boolean                   @default(false)
  waterTank                     Boolean                   @default(false)
  securityWall                  Boolean                   @default(false)
  electricFence                 Boolean                   @default(false)
  garden                        Boolean                   @default(false)
  swimmingPool                  Boolean                   @default(false)
  availableFrom                 DateTime?
  verifiedAt                    DateTime?
  expiresAt                     DateTime?
  leadSource                    LeadSource                @default(HOUSELINK)
  leadCreatedById               String?
  assignedAgentId               String?
  propertyOwnerName             String?
  propertyOwnerEmail            String?
  propertyOwnerPhone            String?
  duplicateOwnerReviewStatus    LeadOwnershipReviewStatus @default(NOT_REQUIRED)
  duplicateOwnerMatchId         String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  neighbourhoodId               String?
  featured                      Boolean                   @default(false)
  featuredUntil                 DateTime?
  views                         Int                       @default(0)
  adminNotes                    String?
  slug                          String                    @unique
  ownerAgreementAccepted        Boolean                   @default(false)
  ownerAgreementSignedAt        DateTime?
  ownerAgreementSignerName      String?
  ownerAgreementVersion         String?
  ownerAgreementBypassedAt      DateTime?
  ownerAgreementBypassedById    String?
  ownerAgreementBypassedByName  String?
  ownerAgreementBypassedByEmail String?
  ownerAgreementBypassReason    String?
  enquiries                     Enquiry[]
  favourites                    Favourite[]
  agency                        Agency?                   @relation(fields: [agencyId], references: [id])
  neighbourhood                 Neighbourhood?            @relation(fields: [neighbourhoodId], references: [id])
  owner                         User                      @relation(fields: [ownerId], references: [id])
  media                         ListingMedia[]
  virtualTour                   ListingVirtualTour?
  marketInsightSnapshots        MarketInsightSnapshot[]
  payments                      Payment[]
  reports                       Report[]
  reviews                       Review[]
  signedAgreements              SignedAgreement[]
  viewingAppointments           ViewingAppointment[]

  @@index([city, suburb])
  @@index([intent, propertyType, status])
  @@index([leadSource])
  @@index([assignedAgentId])
  @@index([propertyOwnerEmail])
  @@index([propertyOwnerPhone])
  @@index([price])
  @@index([slug])
}

model ListingMedia {
  id        String   @id @default(cuid())
  listingId String
  url       String
  publicId  String
  mediaType String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ListingVirtualTour {
  id              String             @id @default(cuid())
  listingId       String             @unique
  title           String
  status          String             @default("DRAFT")
  provider        String             @default("INTERNAL")
  externalUrl     String?
  coverSceneId    String?
  adminVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  listing         Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  events          VirtualTourEvent[]
  scenes          VirtualTourScene[]

  @@index([status])
}

model VirtualTourScene {
  id        String             @id @default(cuid())
  tourId    String
  title     String
  imageUrl  String
  sortOrder Int                @default(0)
  hotspots  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tour      ListingVirtualTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, sortOrder])
}

model VirtualTourEvent {
  id        String             @id @default(cuid())
  tourId    String
  listingId String
  sceneId   String?
  eventType String
  metadata  Json?
  createdAt DateTime           @default(now())
  tour      ListingVirtualTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, createdAt])
  @@index([listingId, createdAt])
  @@index([eventType])
}

model ViewingAppointment {
  id              String    @id @default(cuid())
  referenceNumber String    @unique
  listingId       String
  enquiryId       String?
  seekerId        String?
  seekerName      String
  seekerEmail     String?
  seekerPhone     String?
  agentId         String?
  agentName       String?
  startAt         DateTime
  endAt           DateTime
  status          String    @default("REQUESTED")
  location        String
  notes           String?
  reminderAt      DateTime?
  confirmedAt     DateTime?
  rescheduledAt   DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  auditTrail      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startAt])
  @@index([enquiryId])
  @@index([agentId, startAt])
  @@index([status])
}

model AgentViewingAvailability {
  agentId   String   @id
  schedule  Json
  updatedAt DateTime @updatedAt
  agent     User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model SignedAgreement {
  id            String   @id @default(cuid())
  subjectType   String
  subjectId     String
  listingId     String?
  title         String
  signerUserId  String?
  signerName    String
  signerEmail   String?
  signerRole    String
  signatureText String
  agreementText String
  contentHash   String
  pdfBase64     String
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  signedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  listing       Listing? @relation(fields: [listingId], references: [id])

  @@index([subjectType, subjectId])
  @@index([listingId])
  @@index([signerUserId])
  @@index([signedAt])
}

model MarketInsightSnapshot {
  id                   String   @id @default(cuid())
  city                 String
  suburb               String
  propertyType         String
  intent               String   @default("rent")
  listingId            String?
  sampleSize           Int      @default(0)
  medianPrice          Decimal  @default(0) @db.Decimal(12, 2)
  averagePrice         Decimal  @default(0) @db.Decimal(12, 2)
  recommendedPriceMin  Decimal  @default(0) @db.Decimal(12, 2)
  recommendedPriceMax  Decimal  @default(0) @db.Decimal(12, 2)
  demandScore          Int      @default(0)
  vacancyRisk          String   @default("UNKNOWN")
  comparableListingIds String[] @default([])
  payload              Json?
  createdAt            DateTime @default(now())
  listing              Listing? @relation(fields: [listingId], references: [id])

  @@index([city, suburb, propertyType])
  @@index([listingId])
  @@index([createdAt])
}

model Favourite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model SavedSearch {
  id        String                @id @default(cuid())
  userId    String
  name      String
  query     Json
  channels  NotificationChannel[] @default([EMAIL])
  enabled   Boolean               @default(true)
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id        String   @id @default(cuid())
  listingId String
  seekerId  String
  message   String
  channel   String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seeker    User     @relation("SeekerEnquiries", fields: [seekerId], references: [id], onDelete: Cascade)
}

/// Full CRM enquiry document — synced from runtime store when PostgreSQL is enabled.
model PropertyEnquiryRecord {
  id               String   @id
  subjectType      String   @default("LISTING")
  listingId        String?
  roommateUserId   String?
  holidayBookingId String?
  seekerId         String
  ownerId          String?
  status           String
  enquiryType      String
  assignedAgentId  String?
  payload          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([seekerId])
  @@index([assignedAgentId])
  @@index([ownerId])
  @@index([subjectType])
  @@index([createdAt])
}

model ResidenceRecordRow {
  id             String   @id
  tenancyId      String
  userId         String
  counterpartyId String
  listingId      String?
  status         String
  verified       Boolean  @default(false)
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenancyId])
  @@index([userId])
  @@index([counterpartyId])
  @@index([listingId])
  @@index([status])
  @@index([verified])
}

model TenancyReferenceRow {
  id           String   @id
  tenancyId    String
  targetUserId String
  payload      Json
  createdAt    DateTime @default(now())

  @@index([tenancyId])
  @@index([targetUserId])
}

model TenancyDisputeRow {
  id        String   @id
  tenancyId String
  status    String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenancyId])
  @@index([status])
}

model PropertyManagementRequestRow {
  id            String   @id
  requestNumber String   @unique
  ownerId       String
  status        String
  consultantId  String?
  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([consultantId])
}

model HolidayBookingRecord {
  id          String   @id
  listingId   String
  guestUserId String
  ownerId     String?
  agentId     String?
  status      String
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([listingId])
  @@index([guestUserId])
  @@index([ownerId])
  @@index([agentId])
  @@index([status])
}

model AgentApplicationRecord {
  id        String   @id
  userId    String   @unique
  status    String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model AgentTrainingProgressRecord {
  id        String   @id @default(cuid())
  agentId   String
  moduleId  String
  status    String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, moduleId])
  @@index([agentId])
  @@index([status])
}

model AgentTrainingModuleRecord {
  id              String   @id
  title           String
  description     String
  type            String
  contentUrl      String?
  durationMinutes Int      @default(0)
  required        Boolean  @default(true)
  order           Int      @default(0)
  active          Boolean  @default(true)
  payload         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@index([required])
  @@index([order])
}

model Conversation {
  id           String                    @id @default(cuid())
  listingId    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
}

model RoommateProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  budgetMin          Decimal         @db.Decimal(12, 2)
  budgetMax          Decimal         @db.Decimal(12, 2)
  occupation         String?
  genderPreference   String?
  lifestyle          String?
  smoking            Boolean         @default(false)
  pets               Boolean         @default(false)
  age                Int?
  preferredLocations String[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  active             Boolean         @default(true)
  payload            Json?
  matchesAsCandidate RoommateMatch[] @relation("RoommateCandidate")
  matchesAsSource    RoommateMatch[] @relation("RoommateSource")
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoommateMatch {
  id          String          @id @default(cuid())
  sourceId    String
  candidateId String
  score       Int
  reasons     String[]
  createdAt   DateTime        @default(now())
  candidate   RoommateProfile @relation("RoommateCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  source      RoommateProfile @relation("RoommateSource", fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, candidateId])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  listingId String?
  rating    Int
  body      String
  target    String
  createdAt DateTime @default(now())
  metadata  Json?
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  listing   Listing? @relation(fields: [listingId], references: [id])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String?
  listingId  String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User?        @relation(fields: [reporterId], references: [id])
}

model UserDocument {
  id        String             @id @default(cuid())
  userId    String
  url       String
  publicId  String
  type      String
  status    VerificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String                      @id @default(cuid())
  userId                String
  listingId             String?
  provider              PaymentProvider
  status                PaymentStatus               @default(PENDING)
  amount                Decimal                     @db.Decimal(12, 2)
  currency              String                      @default("USD")
  description           String
  externalId            String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  plan                  String?
  method                String?
  manual                Boolean                     @default(false)
  proofUrl              String?
  proofStatus           String?
  metadata              Json?
  listing               Listing?                    @relation(fields: [listingId], references: [id])
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  academyApplications   AcademyLearnerApplication[]
  academyResourceAccess AcademyResourceAccess[]
  libraryOrders         LibraryOrder[]
  refundRequests        RefundRequest[]
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  subject   String
  body      String
  createdAt DateTime            @default(now())
  sentAt    DateTime?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Neighbourhood {
  id             String    @id @default(cuid())
  city           String
  suburb         String
  summary        String
  safetyScore    Int?
  waterScore     Int?
  transportScore Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  listings       Listing[]

  @@unique([city, suburb])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

model AppSession {
  id         String    @id
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  email     String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String   @unique
  token       String   @unique
  redirectUrl String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  ipAddress   String?
  userAgent   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([usedAt])
}

model LegalPageRecord {
  id            String   @id
  title         String
  summary       String
  body          String
  effectiveDate DateTime
  status        String
  savedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AgentLeadRecord {
  id                         String                    @id @default(cuid())
  listingId                  String?
  listingTitle               String?
  leadSource                 LeadSource                @default(HOUSELINK)
  acquisitionChannel         String?
  createdById                String?
  createdByName              String?
  assignedAgentId            String?
  assignedAgentName          String?
  propertyOwnerId            String?
  propertyOwnerName          String?
  propertyOwnerEmail         String?
  propertyOwnerPhone         String?
  clientName                 String
  clientEmail                String?
  clientPhone                String?
  clientType                 String
  status                     String
  city                       String?
  suburb                     String?
  province                   String?
  notes                      String?
  duplicateOwnerReviewStatus LeadOwnershipReviewStatus @default(NOT_REQUIRED)
  duplicateOwnerMatchId      String?
  payload                    Json?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  commissions                AgentCommissionRecord[]
  ownershipAudits            LeadOwnershipAudit[]

  @@index([leadSource])
  @@index([assignedAgentId])
  @@index([propertyOwnerEmail])
  @@index([propertyOwnerPhone])
  @@index([status])
  @@index([createdAt])
}

model AgentCommissionRule {
  id                    String                  @id @default(cuid())
  type                  String
  label                 String
  leadSource            LeadSource?
  scope                 CommissionRuleScope     @default(DEFAULT)
  agentId               String?
  transactionId         String?
  branchId              String?
  propertyType          String?
  agentLevel            String?
  promotionCode         String?
  priority              Int                     @default(100)
  ratePercent           Decimal                 @db.Decimal(5, 2)
  houselinkSplitPercent Decimal                 @db.Decimal(5, 2)
  agentSplitPercent     Decimal                 @db.Decimal(5, 2)
  minAmount             Decimal                 @default(0) @db.Decimal(12, 2)
  maxAmount             Decimal                 @default(0) @db.Decimal(12, 2)
  vatPercent            Decimal                 @default(0) @db.Decimal(5, 2)
  bonusPercent          Decimal                 @default(0) @db.Decimal(5, 2)
  reason                String?
  active                Boolean                 @default(true)
  startsAt              DateTime?
  endsAt                DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  commissions           AgentCommissionRecord[]
  audits                CommissionAudit[]

  @@index([type, active])
  @@index([leadSource])
  @@index([scope])
  @@index([agentId])
  @@index([transactionId])
  @@index([branchId])
  @@index([propertyType])
  @@index([agentLevel])
  @@index([promotionCode])
}

model AgentCommissionRecord {
  id                  String                @id @default(cuid())
  leadId              String?
  listingId           String?
  agentId             String
  agentName           String
  type                String
  status              AgentCommissionStatus @default(PENDING)
  paymentStatus       AgentCommissionStatus @default(PENDING)
  dealRef             String                @unique
  leadSource          LeadSource            @default(HOUSELINK)
  commissionRuleId    String?
  commissionRuleLabel String?
  commissionPercent   Decimal               @db.Decimal(5, 2)
  grossAmount         Decimal               @db.Decimal(12, 2)
  houselinkAmount     Decimal               @db.Decimal(12, 2)
  agentAmount         Decimal               @db.Decimal(12, 2)
  taxAmount           Decimal               @db.Decimal(12, 2)
  netAgentAmount      Decimal               @db.Decimal(12, 2)
  currency            String                @default("USD")
  ruleSnapshot        Json
  reason              String?
  approvedAt          DateTime?
  approvedBy          String?
  paidAt              DateTime?
  payout              Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  rule                AgentCommissionRule?  @relation(fields: [commissionRuleId], references: [id])
  lead                AgentLeadRecord?      @relation(fields: [leadId], references: [id])
  audits              CommissionAudit[]

  @@index([agentId])
  @@index([leadSource])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model LeadOwnershipAudit {
  id                 String          @id @default(cuid())
  leadId             String
  changedById        String
  changedByName      String
  oldLeadSource      LeadSource?
  newLeadSource      LeadSource
  oldAssignedAgentId String?
  newAssignedAgentId String?
  reason             String
  createdAt          DateTime        @default(now())
  lead               AgentLeadRecord @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([changedById])
  @@index([createdAt])
}

model CommissionAudit {
  id                      String                 @id @default(cuid())
  commissionId            String?
  ruleId                  String?
  changedById             String
  changedByName           String
  action                  String
  oldHomelinkSplitPercent Decimal?               @db.Decimal(5, 2)
  newHomelinkSplitPercent Decimal?               @db.Decimal(5, 2)
  oldAgentSplitPercent    Decimal?               @db.Decimal(5, 2)
  newAgentSplitPercent    Decimal?               @db.Decimal(5, 2)
  reason                  String
  createdAt               DateTime               @default(now())
  commission              AgentCommissionRecord? @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  rule                    AgentCommissionRule?   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([commissionId])
  @@index([ruleId])
  @@index([changedById])
  @@index([createdAt])
}

/// Full in-memory marketplace snapshot for runtime persistence (JSON payload).
model AppStoreSnapshot {
  id        String   @id @default("singleton")
  version   Int
  payload   Json
  updatedAt DateTime @updatedAt
}

model TrainingCategory {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  parentId    String?
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  courses     TrainingCourse[]

  @@map("training_categories")
}

model TrainingCourse {
  id                  String                      @id @default(cuid())
  title               String
  slug                String                      @unique
  thumbnailUrl        String?
  bannerUrl           String?
  description         String
  categoryId          String?
  tags                String[]                    @default([])
  difficulty          TrainingDifficulty          @default(BEGINNER)
  durationMinutes     Int                         @default(0)
  instructor          String?
  prerequisites       String[]                    @default([])
  passingPercentage   Int                         @default(80)
  estimatedHours      Decimal                     @default(0) @db.Decimal(6, 2)
  certificateEnabled  Boolean                     @default(false)
  expiresAfterDays    Int?
  version             Int                         @default(1)
  language            String                      @default("English")
  status              TrainingCourseStatus        @default(DRAFT)
  featured            Boolean                     @default(false)
  visibility          TrainingVisibility          @default(INTERNAL_ONLY)
  branchIds           String[]                    @default([])
  roleNames           String[]                    @default([])
  createdById         String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  price               Decimal                     @default(0) @db.Decimal(12, 2)
  publicPrice         Decimal                     @default(0) @db.Decimal(12, 2)
  agentPrice          Decimal                     @default(0) @db.Decimal(12, 2)
  currency            String                      @default("USD")
  registrationOpen    Boolean                     @default(false)
  accessDurationDays  Int                         @default(365)
  subtitle            String?
  shortDescription    String?
  coInstructors       String[]                    @default([])
  learningOutcomes    String[]                    @default([])
  targetAudience      String?
  introVideoUrl       String?
  previewVideoUrl     String?
  welcomeVideoUrl     String?
  seoTitle            String?
  seoDescription      String?
  enrollmentType      String                      @default("OPEN")
  capacity            Int?
  discountPrice       Decimal?                    @db.Decimal(12, 2)
  toolkitPublicPrice  Decimal                     @default(15) @db.Decimal(12, 2)
  toolkitAgentPrice   Decimal                     @default(0) @db.Decimal(12, 2)
  toolkitSalesEnabled Boolean                     @default(true)
  publicApplications  AcademyLearnerApplication[]
  resourceAccess      AcademyResourceAccess[]
  assignments         Assignment[]
  certificateIssues   CertificateIssue[]
  enrolments          CourseEnrolment[]
  progress            CourseProgress[]
  reviews             CourseReview[]
  waitlistEntries     CourseWaitlist[]
  discussions         DiscussionThread[]
  finalExams          FinalExam[]
  forum               Forum?
  pathCourses         PathCourse[]
  quizzes             Quiz[]
  category            TrainingCategory?           @relation(fields: [categoryId], references: [id])
  modules             TrainingModule[]

  @@index([status])
  @@index([categoryId])
  @@index([featured])
  @@map("training_courses")
}

model AcademyLearnerApplication {
  id               String                    @id @default(cuid())
  learnerId        String
  courseId         String
  paymentId        String?
  status           AcademyRegistrationStatus @default(PENDING_PAYMENT)
  learnerType      String                    @default("PUBLIC_LEARNER")
  fullName         String
  email            String
  phone            String?
  organisation     String?
  motivation       String?
  amount           Decimal                   @default(0) @db.Decimal(12, 2)
  currency         String                    @default("USD")
  proofUrl         String?
  adminNote        String?
  approvedById     String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  accessStartsAt   DateTime?
  accessEndsAt     DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  course           TrainingCourse            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learner          User                      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  payment          Payment?                  @relation(fields: [paymentId], references: [id])
  paymentReminders PaymentReminder[]

  @@unique([learnerId, courseId])
  @@index([status])
  @@index([courseId])
  @@index([paymentId])
  @@map("academy_learner_applications")
}

model AcademyResourceAccess {
  id             String                    @id @default(cuid())
  learnerId      String
  resourceKind   AcademyResourceKind
  resourceKey    String
  courseId       String?
  status         AcademyRegistrationStatus @default(PENDING_PAYMENT)
  paymentId      String?
  learnerType    String                    @default("PUBLIC_LEARNER")
  fullName       String
  email          String
  phone          String?
  amount         Decimal                   @default(0) @db.Decimal(12, 2)
  currency       String                    @default("USD")
  proofUrl       String?
  adminNote      String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  accessStartsAt DateTime?
  accessEndsAt   DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  course         TrainingCourse?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learner        User                      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  payment        Payment?                  @relation(fields: [paymentId], references: [id])

  @@unique([learnerId, resourceKey])
  @@index([status])
  @@index([courseId])
  @@index([paymentId])
  @@map("academy_resource_access")
}

model TrainingModule {
  id               String            @id @default(cuid())
  courseId         String
  title            String
  description      String?
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  objectives       String[]          @default([])
  estimatedMinutes Int               @default(0)
  assignments      Assignment[]
  quizzes          Quiz[]
  course           TrainingCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections         TrainingSection[]

  @@index([courseId, sortOrder])
  @@map("training_modules")
}

model TrainingSection {
  id          String           @id @default(cuid())
  moduleId    String
  title       String
  description String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lessons     TrainingLesson[]
  module      TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, sortOrder])
  @@map("training_sections")
}

model TrainingLesson {
  id                    String           @id @default(cuid())
  sectionId             String
  title                 String
  summary               String?
  richText              String           @default("")
  videoUrl              String?
  embeddedVideoUrl      String?
  coverImageUrl         String?
  pdfUrl                String?
  audioUrl              String?
  mapEmbedUrl           String?
  estimatedMinutes      Int              @default(0)
  completionRequirement String           @default("VIEW")
  sortOrder             Int              @default(0)
  commentsEnabled       Boolean          @default(true)
  bookmarksEnabled      Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  transcript            String?
  lessonNotes           String?
  objectives            String[]         @default([])
  discussionPrompt      String?
  checklist             Json?
  reflectionQuestions   Json?
  assignments           Assignment[]
  lessonDocuments       LessonDocument[]
  lessonDownloads       LessonDownload[]
  progress              LessonProgress[]
  lessonResources       LessonResource[]
  lessonVideos          LessonVideo[]
  quizzes               Quiz[]
  section               TrainingSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
  @@map("training_lessons")
}

model LessonVideo {
  id              String         @id @default(cuid())
  lessonId        String
  title           String
  url             String
  provider        String         @default("UPLOAD")
  durationSeconds Int            @default(0)
  captionsUrl     String?
  downloadable    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  lesson          TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_videos")
}

model LessonDocument {
  id         String          @id @default(cuid())
  lessonId   String
  documentId String
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  document   DocumentLibrary @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lesson     TrainingLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, documentId])
  @@map("lesson_documents")
}

model LessonResource {
  id        String         @id @default(cuid())
  lessonId  String
  title     String
  body      String
  type      String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  lesson    TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_resources")
}

model LessonDownload {
  id        String               @id @default(cuid())
  lessonId  String
  title     String
  url       String
  type      TrainingResourceType
  createdAt DateTime             @default(now())
  lesson    TrainingLesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_downloads")
}

model Quiz {
  id                String          @id @default(cuid())
  courseId          String?
  title             String
  description       String?
  passingPercentage Int             @default(80)
  randomise         Boolean         @default(false)
  timeLimitMinutes  Int?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  moduleId          String?
  lessonId          String?
  attempts          QuizAttempt[]
  questions         QuizQuestion[]
  course            TrainingCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson            TrainingLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module            TrainingModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id                String               @id @default(cuid())
  quizId            String?
  bankId            String?
  type              TrainingQuestionType
  prompt            String
  points            Int                  @default(1)
  explanation       String?
  correctAnswer     Json
  incorrectFeedback String?
  hints             String[]             @default([])
  difficulty        TrainingDifficulty   @default(BEGINNER)
  randomise         Boolean              @default(false)
  mediaUrl          String?
  attachments       Json?
  categories        String[]             @default([])
  tags              String[]             @default([])
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  answers           QuizAnswer[]
  bank              QuestionBank?        @relation(fields: [bankId], references: [id])
  quiz              Quiz?                @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([bankId])
  @@map("quiz_questions")
}

model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  label      String
  value      String
  isCorrect  Boolean      @default(false)
  feedback   String?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_answers")
}

model QuestionBank {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    String?
  tags        String[]       @default([])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   QuizQuestion[]

  @@map("question_bank")
}

model QuizAttempt {
  id          String                @id @default(cuid())
  quizId      String
  agentId     String
  status      TrainingAttemptStatus @default(IN_PROGRESS)
  score       Decimal               @default(0) @db.Decimal(6, 2)
  answers     Json
  startedAt   DateTime              @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?
  quiz        Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([agentId])
  @@map("quiz_attempts")
}

model FinalExam {
  id              String         @id @default(cuid())
  courseId        String
  title           String
  durationMinutes Int            @default(60)
  passingScore    Int            @default(80)
  randomQuestions Boolean        @default(true)
  questionPools   Json?
  attemptLimit    Int            @default(2)
  browserLock     Boolean        @default(false)
  autoSubmit      Boolean        @default(true)
  retakeRules     Json?
  reviewEnabled   Boolean        @default(true)
  manualGrading   Boolean        @default(false)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  attempts        ExamAttempt[]
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("final_exams")
}

model ExamAttempt {
  id          String                @id @default(cuid())
  examId      String
  agentId     String
  status      TrainingAttemptStatus @default(IN_PROGRESS)
  score       Decimal               @default(0) @db.Decimal(6, 2)
  answers     Json
  startedAt   DateTime              @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?
  exam        FinalExam             @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([agentId])
  @@map("exam_attempts")
}

model Assignment {
  id          String                 @id @default(cuid())
  courseId    String?
  title       String
  description String
  dueDays     Int?
  points      Int                    @default(100)
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  moduleId    String?
  lessonId    String?
  submissions AssignmentSubmission[]
  course      TrainingCourse?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      TrainingLesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module      TrainingModule?        @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
  @@index([lessonId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String                     @id @default(cuid())
  assignmentId String
  agentId      String
  status       AssignmentSubmissionStatus @default(SUBMITTED)
  notes        String?
  fileUrls     String[]                   @default([])
  grade        Decimal?                   @db.Decimal(6, 2)
  reviewerId   String?
  reviewerNote String?
  submittedAt  DateTime                   @default(now())
  reviewedAt   DateTime?
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([agentId])
  @@map("assignment_submissions")
}

model CourseEnrolment {
  id         String         @id @default(cuid())
  courseId   String
  agentId    String
  status     String         @default("ACTIVE")
  enrolledAt DateTime       @default(now())
  dueAt      DateTime?
  course     TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, agentId])
  @@index([agentId])
  @@map("course_enrolments")
}

model LessonProgress {
  id              String         @id @default(cuid())
  lessonId        String
  agentId         String
  status          String         @default("NOT_STARTED")
  percentComplete Int            @default(0)
  readingSeconds  Int            @default(0)
  completedAt     DateTime?
  lastViewedAt    DateTime       @default(now())
  lesson          TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, agentId])
  @@index([agentId])
  @@map("lesson_progress")
}

model CourseProgress {
  id              String         @id @default(cuid())
  courseId        String
  agentId         String
  status          String         @default("NOT_STARTED")
  percentComplete Int            @default(0)
  averageScore    Decimal        @default(0) @db.Decimal(6, 2)
  learningMinutes Int            @default(0)
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, agentId])
  @@index([agentId])
  @@map("course_progress")
}

model LearningPath {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      String       @default("DRAFT")
  badgeTitle  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     PathCourse[]

  @@map("learning_paths")
}

model PathCourse {
  id        String         @id @default(cuid())
  pathId    String
  courseId  String
  sortOrder Int            @default(0)
  required  Boolean        @default(true)
  course    TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  path      LearningPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@map("path_courses")
}

model Certificate {
  id          String   @id @default(cuid())
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("certificates")
}

model CertificateTemplate {
  id            String             @id @default(cuid())
  name          String
  backgroundUrl String?
  logoUrl       String?
  signatureUrl  String?
  templateJson  Json
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  issues        CertificateIssue[]

  @@map("certificate_templates")
}

model CertificateIssue {
  id                String               @id @default(cuid())
  certificateNumber String               @unique
  courseId          String?
  agentId           String
  templateId        String?
  qrCodeUrl         String?
  pdfUrl            String?
  status            String               @default("ACTIVE")
  issuedAt          DateTime             @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  course            TrainingCourse?      @relation(fields: [courseId], references: [id])
  template          CertificateTemplate? @relation(fields: [templateId], references: [id])

  @@index([agentId])
  @@index([courseId])
  @@map("certificate_issues")
}

model DocumentCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  documents   DocumentLibrary[]

  @@map("document_categories")
}

model DocumentLibrary {
  id              String               @id @default(cuid())
  categoryId      String?
  title           String
  description     String?
  fileUrl         String
  fileName        String
  fileType        TrainingResourceType
  fileSizeBytes   Int                  @default(0)
  version         Int                  @default(1)
