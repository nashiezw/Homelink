  @@index([courseId])
  @@index([moduleId])
  @@index([status])
  @@map("academy_module_feedback")
}

model TrainingSetting {
  id        String   @id @default("singleton")
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("training_settings")
}

model AcademyEmailTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique
  language    String   @default("en")
  subject     String
  htmlContent String
  textContent String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([templateKey, language])
  @@map("academy_email_templates")
}

model AcademyBranding {
  id              String   @id @default("singleton")
  logoUrl         String?
  primaryColor    String   @default("#10b981")
  secondaryColor  String   @default("#059669")
  fontColor       String   @default("#333333")
  backgroundColor String   @default("#ffffff")
  customCss       String?
  updatedAt       DateTime @updatedAt

  @@map("academy_branding")
}

model PaymentReminder {
  id             String                    @id @default(cuid())
  registrationId String
  reminderDay    Int
  sentAt         DateTime?
  delivered      Boolean                   @default(false)
  converted      Boolean                   @default(false)
  convertedAt    DateTime?
  createdAt      DateTime                  @default(now())
  registration   AcademyLearnerApplication @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([sentAt])
  @@map("payment_reminders")
}

model CourseWaitlist {
  id         String         @id @default(cuid())
  courseId   String
  learnerId  String
  priority   Int            @default(0)
  notifiedAt DateTime?
  enrolledAt DateTime?
  createdAt  DateTime       @default(now())
  course     TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learner    User           @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([courseId, learnerId])
  @@index([courseId])
  @@index([learnerId])
  @@map("course_waitlists")
}

model CourseReview {
  id        String         @id @default(cuid())
  courseId  String
  learnerId String
  rating    Int
  title     String?
  comment   String
  approved  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learner   User           @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([courseId, learnerId])
  @@index([courseId])
  @@index([learnerId])
  @@map("course_reviews")
}

model Forum {
  id          String         @id @default(cuid())
  courseId    String         @unique
  title       String
  description String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  posts       ForumPost[]
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("forums")
}

model ForumPost {
  id        String       @id @default(cuid())
  forumId   String
  learnerId String
  title     String
  content   String
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  forum     Forum        @relation(fields: [forumId], references: [id], onDelete: Cascade)
  learner   User         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  replies   ForumReply[]

  @@index([forumId])
  @@index([learnerId])
  @@map("forum_posts")
}

model ForumReply {
  id        String    @id @default(cuid())
  postId    String
  learnerId String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  learner   User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([learnerId])
  @@map("forum_replies")
}

model RefundRequest {
  id          String    @id @default(cuid())
  paymentId   String
  learnerId   String
  reason      String
  status      String    @default("PENDING")
  adminNote   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  learner     User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([learnerId])
  @@map("refund_requests")
}

model PushNotification {
  id     String    @id @default(cuid())
  userId String
  title  String
  body   String
  type   String
  data   Json?
  read   Boolean   @default(false)
  sentAt DateTime  @default(now())
  readAt DateTime?
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("push_notifications")
}

model LearnerAnalytics {
  id               String    @id @default(cuid())
  learnerId        String
  courseId         String?
  lastLoginAt      DateTime?
  loginCount       Int       @default(0)
  lessonsCompleted Int       @default(0)
  totalTimeSpent   Int       @default(0)
  engagementScore  Float     @default(0)
  riskLevel        String?
  date             DateTime  @default(now())
  learner          User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, courseId, date])
  @@index([learnerId])
  @@index([courseId])
  @@map("learner_analytics")
}

model TrainingAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json
  createdAt DateTime @default(now())

  @@index([actorId])
  @@map("training_audit_logs")
}

model AcademyCoupon {
  id                String               @id @default(cuid())
  code              String               @unique
  description       String?
  discountType      CouponDiscountType   @default(PERCENTAGE)
  discountValue     Decimal              @db.Decimal(5, 2)
  maxUses           Int?
  usedCount         Int                  @default(0)
  minPurchaseAmount Decimal?             @db.Decimal(12, 2)
  validFrom         DateTime             @default(now())
  validUntil        DateTime?
  applicableCourses String[]             @default([])
  applicableRoles   String[]             @default([])
  active            Boolean              @default(true)
  createdBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  usages            AcademyCouponUsage[]
  createdByUser     User?                @relation(fields: [createdBy], references: [id])

  @@index([code])
  @@index([active])
  @@index([validFrom, validUntil])
  @@map("academy_coupons")
}

model AcademyCouponUsage {
  id             String        @id @default(cuid())
  couponId       String
  userId         String
  paymentId      String
  discountAmount Decimal       @db.Decimal(12, 2)
  originalAmount Decimal       @db.Decimal(12, 2)
  finalAmount    Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  coupon         AcademyCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([paymentId])
  @@map("academy_coupon_usages")
}

model SitePageView {
  id          String    @id @default(cuid())
  visitorId   String
  sessionId   String
  path        String
  title       String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  deviceType  String
  durationMs  Int?
  userId      String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([visitorId])
  @@index([sessionId])
  @@index([path])
  @@index([startedAt])
  @@index([deviceType])
  @@index([utmSource])
}

model SiteFunnelEvent {
  id         String   @id @default(cuid())
  visitorId  String
  sessionId  String?
  name       String
  path       String?
  target     String?
  deviceType String?
  referrer   String?
  metadata   Json?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([visitorId])
  @@index([createdAt])
}

model SitePresence {
  id            String   @id @default(cuid())
  visitorId     String   @unique
  sessionId     String
  path          String
  title         String?
  deviceType    String?
  userId        String?
  productId     String?
  productTitle  String?
  cartItemCount Int      @default(0)
  cartValue     Float    @default(0)
  cartCurrency  String?
  cartSummary   Json?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([path])
  @@index([sessionId])
}

